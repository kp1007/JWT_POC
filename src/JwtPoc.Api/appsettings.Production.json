{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=production-server;Database=JwtPocDb;User Id=dbuser;Password=***;Encrypt=true;TrustServerCertificate=false"
  },
  "Jwt": {
    "SecretKey": "*** REPLACE WITH SECURE KEY FROM ENVIRONMENT VARIABLE ***",
    "AccessTokenExpirationMinutes": 15
  },
  "Security": {
    "MaxLoginAttempts": 5,
    "RequireEmailConfirmation": true
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60
  },
  "Application": {
    "Environment": "Production"
  }
}
